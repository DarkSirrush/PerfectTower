:name Museum:Auto Gem

:global int MaxGemSlot
:global int GemSlot
:global int GemTier
:local int CombineCount

isopen("museum")

MaxGemSlot = 135
GemSlot = 0
GemTier = 0
museum.moveTo("loadout", GemSlot, "inventory", 0)
gotoif(14, -1 == tier("inventory", 0))
GemTier = min(tier("inventory", 0), museum.preferredTier())
gotoif(14, GemTier < tier("inventory", 0))
museum.buyTier(element("inventory", 0), 1, freeSlots("inventory"))
CombineCount = 0
combine(0)
CombineCount = CombineCount + 1
gotoif(10, CombineCount <= 7)
gotoif(8, tier("inventory", 0) <= GemTier)
museum.moveTo("inventory", 0, "loadout", GemSlot)
clear("inventory")
GemSlot = GemSlot + 1
gotoif(4, GemSlot < MaxGemSlot)
goto(0)